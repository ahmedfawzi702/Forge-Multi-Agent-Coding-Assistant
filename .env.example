# Copy to .env in the repository root. Relative paths resolve from this repository.
DATABASE_URL=sqlite:///.data/forge.db
# PostgreSQL alternative: postgresql+psycopg://user:password@localhost:5432/forge
# JSON array; only projects underneath these directories may be opened.
WORKSPACE_ROOTS=["."]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# evidence = offline project facts only; it does not simulate an LLM.
LLM_PROVIDER=evidence
LLM_MODEL=
LLM_API_KEY=
# Ollama example: http://127.0.0.1:11434
# OpenAI-compatible example: https://api.openai.com/v1
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=90
# Enable only for compatible models that support response_format=json_object.
LLM_JSON_MODE=false
LLM_MAX_OUTPUT_TOKENS=8192
# Native tool calls for compatible OpenAI/OpenRouter and Ollama models.
LLM_TOOLS_ENABLED=true
# Optional JSON map; absent roles use LLM_MODEL. No automatic paid fallback.
LLM_ROLE_MODELS={}
# Opt-in only. These models use the same configured provider and credentials.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_MODELS=[]
AGENT_TIMEOUT_SECONDS=600
# Separate exploration, implementation, repair and last-resort global limits.
FORGE_MAX_AGENT_STEPS=160
FORGE_MAX_TOOL_CALLS=64
FORGE_MAX_MODEL_CALLS=48
FORGE_MAX_IMPLEMENTATION_CALLS=32
FORGE_MAX_VALIDATION_CALLS=8
FORGE_MAX_TEST_CALLS=4
FORGE_MAX_REVIEW_CALLS=6
FORGE_MAX_CONTEXT_CALLS=12
FORGE_MAX_CONTEXT_FILE_READS=8
FORGE_MAX_CONTEXT_SEARCHES=4
FORGE_CONTEXT_ROUNDS=2
FORGE_IMPLEMENTATION_ROUNDS=8
FORGE_READONLY_ROUNDS=3
FORGE_SUBAGENT_ROUNDS=2
# Total implementation attempts, including the initial implementation.
FORGE_MAX_REPAIR_ATTEMPTS=3
FORGE_MAX_REVIEW_REVISIONS=2
FORGE_MAX_DELEGATIONS=2
MAX_FILES=3000
MAX_FILE_BYTES=262144
CONTEXT_CHAR_BUDGET=24000
# Managed browser imports and temporary validation snapshots; never expands WORKSPACE_ROOTS.
STATE_DIRECTORY=.data
EXECUTION_TIMEOUT_SECONDS=60
EXECUTION_OUTPUT_BYTES=65536
MAX_REQUEST_BYTES=25165824
